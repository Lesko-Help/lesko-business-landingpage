{
  // Cloudflare Workers config — static site + tiny API worker
  "name": "lesko-business-landingpage",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Keeps the console.log/console.error lines subscribe() already writes
  // queryable in the dashboard (Workers Logs) instead of vanishing when
  // the invocation ends - before this, a decline reached us only as a
  // screenshot. head_sampling_rate defaults to 1 (100%) when omitted, but
  // is written out here: an alert line must never be silently sampled out.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Card-testing guard for /api/subscribe: 5 requests per 60s per caller IP.
  // Cloudflare creates the namespace from this config on deploy, no
  // dashboard step needed (unlike the two Recurly secrets).
  "ratelimits": [
    {
      "name": "SUBSCRIBE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Lets the Worker mail Martin itself on a card decline (worker.js's
  // sendDeclineAlertEmail), instead of a BTB_ALERT line in Workers Logs
  // that nothing yet notifies on. destination_address is a safety rail:
  // this binding can only ever send to that one address, even if the
  // code changes. One-time account setup this binding depends on, not
  // done by this deploy: `wrangler email routing enable
  // leskobusiness.com` (Email Routing must be on for the zone the FROM
  // address lives on) and `wrangler email routing addresses create
  // martin.j.menke@gmail.com` + clicking the verification link Cloudflare
  // sends — Cloudflare refuses to deliver to an unverified destination.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "martin.j.menke@gmail.com"
    }
  ]
}
