{
  // Cloudflare Workers config — static site + tiny API worker
  "name": "lesko-business-landingpage",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
